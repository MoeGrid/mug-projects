{
  "name": "mug-project-root",
  "version": "1.0.0",
  "private": true,
  "description": "MUG Arcade & Card Pass Monorepo (Miniapp + Server)",
  "scripts": {
    "dev:app": "pnpm --filter mug-miniapp dev:weapp",
    "dev:miniapp": "pnpm --filter mug-miniapp dev:weapp",
    "dev:server": "pnpm --filter mug-server dev",
    "build:app": "pnpm --filter mug-miniapp build:weapp",
    "build:miniapp": "pnpm --filter mug-miniapp build:weapp",
    "ci:upload": "pnpm --filter mug-miniapp ci:upload",
    "ci:preview": "pnpm --filter mug-miniapp ci:preview",
    "start": "pnpm --filter mug-server start",
    "start:server": "pnpm --filter mug-server start",
    "serve:server": "pnpm --filter mug-server start"
  },
  "keywords": [
    "taro",
    "wechat-miniapp",
    "hono",
    "monorepo"
  ],
  "author": "",
  "license": "ISC"
}
