# 复制为 .env 后填写（字段与老项目 .example.env / config/*.php 对应）
APP_DEBUG=true
APP_HOST=your.domain.com
PORT=3000

# 数据库（老项目 mug_db.*）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mug
DB_CHARSET=utf8

# 登录令牌（老项目 auth.secret / auth.expire）
AUTH_SECRET=
AUTH_EXPIRE=86400

# 微信小程序 + 微信支付（wechat.*；证书文件放 data/pay/ 下）
# 支付走 wechatpay-axios-plugin 的「微信支付公钥」模式（免平台证书下载/轮换）：
#   WECHAT_PAY_MCH_CERT_SERIAL  = 商户API证书序列号(apiclient_cert 的 serial_no)
#   WECHAT_PAY_PUB_KEY_ID       = 微信支付公钥ID(PUB_KEY_ID_xxx)，商户平台->API安全 查询
#   WECHAT_PAY_PUB_KEY_PATH     = 微信支付公钥文件(pub_key.pem)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCHID=
WECHAT_PAY_V3KEY=
WECHAT_PAY_MCH_CERT_SERIAL=
WECHAT_PAY_MCH_KEY=data/pay/mch_key.pem
WECHAT_PAY_PUB_KEY_ID=
WECHAT_PAY_PUB_KEY_PATH=data/pay/pub_key.pem

# MQTT broker（投币指令直连：device/{id}/coin/insert 发、device/+/coin/resp 收）
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=mug-backend

# EMQX HTTP API（设备在线探测：GET /api/v5/clients/:clientid）
EMQX_HOST=http://emqx.tx01.misaka-net.com
EMQX_KEY=
EMQX_SECRET=

# 人脸识别微服务（InsightFace Server）
FACE_HOST=http://face.tx01.misaka-net.com
FACE_API_KEY=5g5EEqf88ZhCVTB1lqSOyxsWUWxeNBMa
FACE_COLLECTION=test

# 文件存储目录（public 磁盘 root）
STORAGE_ROOT=public/storage
